{
  "version": 2,
  "builds": [
    {
      "src": "api/handler.go",
      "use": "@vercel/go"
    }
  ],
  "routes": [
    {
      "src": "/api/convert",
      "dest": "/api/handler.go"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "outputDirectory": "public",
  "buildCommand": "echo 'No build needed for static files'",
  "devCommand": "go run main.go",
  "installCommand": "go mod tidy"
}